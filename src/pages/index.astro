---
import Base from '../layouts/Base.astro';
import Didascalia from '../components/Didascalia.astro';
import { Image } from 'astro:assets';
import { getEntry, getEntries, getCollection, render } from 'astro:content';
import sito from '../data/sito.json';
import { url } from '../lib/url';
import { eta } from '../lib/eta';
import { opereOrdinate } from '../lib/opere';

const opere = await opereOrdinate();
const apertura = (await getEntry('opere', sito.operaInApertura)) ?? opere[0];
const sale = (await getCollection('allestimenti')).sort((a, b) => a.data.ordine - b.data.ordine);
const primaSala = sale[0];
const a = sito.artista;

const capitoli = await Promise.all(
  (await getCollection('capitoli'))
    .sort((x, y) => x.data.ordine - y.data.ordine)
    .map(async (c) => ({
      id: c.id,
      titolo: c.data.titolo,
      opere: (await getEntries(c.data.opere)).filter((o) => o && o.data.pubblicata),
      Content: (await render(c)).Content,
    })),
);
---
<Base attiva="home">
  <h1 class="visivamente-nascosto">Home</h1>

  <section class="sezione presentazione" aria-labelledby="titolo-artista">
    <h2 id="titolo-artista" class="sezione-titolo">L’Artista</h2>
    <p class="lead">{a.presentazione}</p>
    <figure class="ritratto">
      <div class="oblo" role="img" aria-label="Spazio per la foto dell’artista">Foto dell’artista</div>
      <figcaption>{`${a.nomeCompleto || 'Nome e cognome'}, noto come ${sito.nome.toUpperCase()}, `}<span data-nascita={a.dataNascita}>{eta(a.dataNascita)}</span>{` anni, ${a.luogo}`}</figcaption>
    </figure>
  </section>

  <figure class="apertura">
    <a href={url(`opere/${apertura.id}/`)}>
      <Image
        src={apertura.data.immagine}
        alt={apertura.data.alt}
        widths={[640, 1000, 1400]}
        sizes="(min-width: 1000px) 60vw, 100vw"
        loading="eager"
      />
    </a>
    <Didascalia opera={apertura} tag="figcaption" />
  </figure>

  <section class="sezione progetto" aria-labelledby="titolo-progetto">
    <h2 id="titolo-progetto" class="sezione-titolo">Il progetto:<br />{sito.titoloProgetto}</h2>
    <p class="lead">{sito.introduzione}</p>
  </section>

  {capitoli.map(({ id, titolo, opere: abbinate, Content }) => (
    <section class:list={['capitolo', { 'senza-opere': !abbinate.length }]} aria-labelledby={`cap-${id}`}>
      <h3 id={`cap-${id}`}>{titolo}</h3>
      <div class="capitolo-testo"><Content /></div>
      {abbinate.length > 0 && (
        <div class:list={['capitolo-opere', { coppia: abbinate.length > 1 }]}><div class="elenco">
          {abbinate.map((o) => (
            <figure>
              <a href={url(`opere/${o.id}/`)}>
                <Image src={o.data.immagine} alt={o.data.alt} widths={[480, 900]} sizes="(min-width: 760px) 40vw, 100vw" />
              </a>
              <Didascalia opera={o} tag="figcaption" />
            </figure>
          ))}
        </div></div>
      )}
    </section>
  ))}

  <section class="chiusura" aria-label="Opere e allestimenti">
    {primaSala && (
      <figure class="sala">
        <Image src={primaSala.data.immagine} alt={primaSala.data.alt} widths={[800, 1400]} sizes="(min-width: 1000px) 70vw, 100vw" />
      </figure>
    )}
    <p><a class="vai" href={url('opere/')}>Guarda le {opere.length} opere</a></p>
    <p><a class="vai" href={url('allestimenti/')}>Vedi gli allestimenti</a></p>
  </section>
</Base>

<script>
  // L'età resta corretta anche senza ripubblicare il sito.
  document.querySelectorAll<HTMLElement>('[data-nascita]').forEach((el) => {
    const n = new Date(el.dataset.nascita + 'T00:00:00');
    const o = new Date();
    let anni = o.getFullYear() - n.getFullYear();
    if (o.getMonth() < n.getMonth() || (o.getMonth() === n.getMonth() && o.getDate() < n.getDate())) anni--;
    el.textContent = String(anni);
  });
</script>
